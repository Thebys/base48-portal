# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
# Anchored with a leading slash: an unanchored pattern matches directories at any
# depth too, so a bare `cron` would hide cmd/cron/, `server` would hide cmd/server/,
# `import` would hide cmd/import/, and `portal` would hide ansible/group_vars/portal/.
# Already-tracked files keep working, which is what makes it easy to miss.
/portal
/server
/portal-cron
/import
/main

# Legacy binaries (superseded by portal-cron subcommands, were committed by mistake)
/cron
/create_monthly_fees
/report_unmatched_payments
/sync_fio
/sync_fio_payments
/update_debt_status

# Test binary
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Environment files
.env
.env.local
.env.*.local

# Database
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
data/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code
.claude/settings.local.json

