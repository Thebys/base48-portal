# ---------------------------------------------------------------------------
# Base48 Member Portal configuration
#
# Copy to .env and fill in. Used by two run modes:
#   - bare `go run` / `make run`   -> read directly by godotenv
#   - docker compose               -> passed to containers AND used for ${...}
#                                     interpolation in docker-compose.yml
# ---------------------------------------------------------------------------

# Server configuration
# Under docker compose, PORT is forced to 8080 inside the container and the
# published port is PORTAL_BIND_PORT below — set BASE_URL to match that one.
PORT=4848
BASE_URL=https://members.base48.cz

# Database
# SQLite (works for both local dev and Docker). Under docker compose this is
# overridden to file:/app/data/portal.db?_pragma=busy_timeout(5000).
#
# busy_timeout matters: the server and the cron daemon write to the same file, so
# without it a concurrent write fails immediately with "database is locked".
# Note the driver is modernc.org/sqlite, which only understands `_pragma=...`
# parameters -- the older `_fk=1` form is accepted and then silently ignored.
DATABASE_URL=file:data/portal.db?_pragma=busy_timeout(5000)

# Keycloak OIDC Configuration
KEYCLOAK_URL=https://auth.base48.cz
KEYCLOAK_REALM=base48

# Web application client (for user login via browser)
KEYCLOAK_CLIENT_ID=go-member-portal-dev
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Service account client (for automated tasks/cron jobs).
# WARNING: with these set, portal-cron writes roles to the *live* Keycloak.
# Leave empty for any local or staging run against a copy of production data.
KEYCLOAK_SERVICE_ACCOUNT_CLIENT_ID=go-member-portal-service
KEYCLOAK_SERVICE_ACCOUNT_CLIENT_SECRET=your-service-account-secret

# FIO Configuration
BANK_FIO_TOKEN=example-token-content

# QR payment codes
BANK_IBAN=CZ0000000000000000000000
BANK_BIC=FIOBCZPPXXX
BANK_ACCOUNT_CZ=2800691518/2010

# Session Secret (generate with: openssl rand -base64 32)
# Avoid '$' in this value — docker compose treats it as interpolation.
SESSION_SECRET=change-this-to-random-32-byte-string

# SMTP Email Configuration (optional - emails will be skipped if not configured)
# WARNING: EMAIL_ENABLED=true means real mail to real members. Keep it false
# anywhere that is not production.
#
# Under docker compose, a relay running on the HOST is not reachable as
# "localhost" -- that is the container. Use host.docker.internal, which
# docker-compose.yml maps to the bridge gateway.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@base48.cz
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@base48.cz
SMTP_FROM_NAME=Base48 Hackerspace
SMTP_REPLY_TO=rada@lists.base48.cz
# SMTP_SKIP_TLS=true  # For local Postfix relay without TLS

# RevBank (bar kiosk) sync API key — see docs/REVBANK_INTEGRATION.md
REVBANK_API_KEY=

# Web assets path (optional - defaults to "web", relative to the working dir).
# Under docker compose this is forced to /app/web.
# WEB_ROOT=web

# ---------------------------------------------------------------------------
# docker compose only — see docs/DEPLOYMENT_DOCKER.md
# ---------------------------------------------------------------------------

# Where the reverse proxy should find the portal. Keep the address on loopback;
# the container does not terminate TLS.
PORTAL_BIND_ADDR=127.0.0.1
PORTAL_BIND_PORT=8090

# UID:GID the containers run as. Must own the data directory, because the
# SQLite file is bind-mounted from the host.
#   production:         990:985 (pinned by the Ansible playbook)
#   local development:  id -u; id -g
PORTAL_UID=10001
PORTAL_GID=10001

# Host directory holding portal.db.
#   production: /var/lib/member-portal
PORTAL_DATA_DIR=./data

# Image tag and version stamp shown in the portal footer.
# Keep PORTAL_VERSION in sync with the VERSION file at the repo root.
PORTAL_TAG=local
PORTAL_VERSION=1.6.0

TZ=Europe/Prague
