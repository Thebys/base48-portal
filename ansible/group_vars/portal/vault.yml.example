---
# Structure template for the encrypted secrets file. This file holds no secrets
# and is safe to read.
#
# Do NOT create the real vault next to this one: base48-portal is a PUBLIC repo,
# and an encrypted blob published there is downloadable forever and crackable
# offline at leisure (ansible-vault uses only 10k PBKDF2 iterations). The real
# vault lives in base48/servers-config-ng, which is private.
#
# Create it there with `ansible-vault create vault.yml` rather than by copying
# this file and encrypting afterwards -- `create` never writes plaintext to disk,
# so the secrets cannot be picked up by a stray `git add -A`.
#
#   head -c 30 vault.yml     # must print $ANSIBLE_VAULT;1.1;AES256
#
# Keep SESSION_SECRET free of '$' — docker compose reads .env and would treat
# it as interpolation. `openssl rand -hex 32` is safe.

vault_keycloak_client_secret: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
vault_keycloak_service_client_secret: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
vault_session_secret: generate-with-openssl-rand-hex-32
vault_bank_fio_token: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
vault_revbank_api_key: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# No SMTP credentials: SMTP_SKIP_TLS=true means the client talks to the local
# relay without authenticating, so the application never reads them.
