# Managed by Ansible — edits here are overwritten on the next deploy.
# Secrets come from group_vars/portal/vault.yml, settings from vars.yml.

BASE_URL={{ portal_base_url }}

KEYCLOAK_URL={{ portal_keycloak_url }}
KEYCLOAK_REALM={{ portal_keycloak_realm }}
KEYCLOAK_CLIENT_ID={{ portal_keycloak_client_id }}
KEYCLOAK_CLIENT_SECRET={{ vault_keycloak_client_secret }}
KEYCLOAK_SERVICE_ACCOUNT_CLIENT_ID={{ portal_keycloak_service_client_id }}
KEYCLOAK_SERVICE_ACCOUNT_CLIENT_SECRET={{ vault_keycloak_service_client_secret }}

SESSION_SECRET={{ vault_session_secret }}

BANK_FIO_TOKEN={{ vault_bank_fio_token }}
BANK_IBAN={{ portal_bank_iban }}
BANK_BIC={{ portal_bank_bic }}
BANK_ACCOUNT_CZ={{ portal_bank_account_cz }}

REVBANK_API_KEY={{ vault_revbank_api_key }}

# SMTP_USERNAME/PASSWORD are deliberately absent: with SMTP_SKIP_TLS=true the
# client connects to the local relay without authenticating, so the code never
# reads them. Two fewer secrets to hold and rotate.
EMAIL_ENABLED={{ portal_email_enabled | lower }}
SMTP_HOST={{ portal_smtp_host }}
SMTP_PORT={{ portal_smtp_port }}
SMTP_FROM={{ portal_smtp_from }}
SMTP_FROM_NAME={{ portal_smtp_from_name }}
SMTP_REPLY_TO={{ portal_smtp_reply_to }}
SMTP_SKIP_TLS={{ portal_smtp_skip_tls | lower }}

# Read by docker-compose.yml itself, not by the application.
PORTAL_BIND_ADDR={{ portal_bind_addr }}
PORTAL_BIND_PORT={{ portal_bind_port }}
PORTAL_DATA_DIR={{ portal_data_dir }}
PORTAL_UID={{ portal_uid }}
PORTAL_GID={{ portal_gid }}
PORTAL_TAG={{ portal_checkout.after | default('dev') }}
PORTAL_VERSION={{ portal_version }} ({{ portal_checkout.after | default('unknown') }})
TZ={{ portal_tz }}
